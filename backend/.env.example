# ============================================================
#  MODELO DE VARIÁVEIS DE AMBIENTE  (backend)
# ------------------------------------------------------------
#  COPIE este arquivo para ".env" e preencha com valores reais.
#  O arquivo ".env" NUNCA é versionado (está no .gitignore).
#  NENHUMA destas chaves pode aparecer no frontend.
# ============================================================

# --- Servidor ---
PORT=3333
NODE_ENV=development

# --- Segurança / Sessão ---
# Gere um valor longo e aleatório (ex.: 64+ caracteres). NÃO reutilize.
JWT_SECRET=troque-por-um-valor-aleatorio-longo-e-secreto
SESSION_EXPIRES_IN=8h

# Origens autorizadas a chamar a API (CORS). Separe por vírgula.
# Em produção, inclua o endereço do frontend (ex.: https://closetsisters.netlify.app)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- Banco de dados (Postgres compartilhado) ---
# Copie a "Connection String" do seu provedor (Supabase/Neon/Render).
# Geralmente precisa de ?sslmode=require no final.
DATABASE_URL=postgresql://usuario:senha@host:5432/closetsisters?sslmode=require

# --- Integrações FUTURAS (Fase 3) — preencher só quando ativar ---
# Todas ficam SOMENTE no backend, nunca no navegador.
WHATSAPP_API_TOKEN=
CORREIOS_API_USER=
CORREIOS_API_TOKEN=
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
